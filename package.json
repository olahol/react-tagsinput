{
  "name": "react-tagsinput",
  "version": "3.21.0",
  "description": "Highly customizable React component for inputing tags",
  "main": "react-tagsinput.js",
  "peerDependencies": {
    "react": "^19.0.0 || ^18.0.0 || ^17.0.0 || ^16.0.0 || ^15.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.5",
    "@babel/core": "^8.0.5",
    "@babel/plugin-transform-modules-umd": "^8.0.1",
    "@babel/preset-env": "^8.0.5",
    "@babel/preset-react": "^8.0.1",
    "@babel/register": "^8.0.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "jsdom": "^30.0.1",
    "mocha": "^12.0.1",
    "nyc": "^18.0.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sinon": "^22.1.0",
    "standard": "^17.1.2"
  },
  "scripts": {
    "test": "npm run lint && BABEL_ENV=test mocha --require @babel/register",
    "lint": "standard src/index.js",
    "fix": "standard src/index.js --fix",
    "build": "babel --env-name production src/index.js --out-file react-tagsinput.js",
    "coverage": "nyc --reporter=lcov --reporter=text-summary npm test",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/olahol/react-tagsinput"
  },
  "keywords": [
    "react",
    "tags",
    "input",
    "component",
    "javascript",
    "react-component"
  ],
  "author": "Ola Holmström",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/olahol/react-tagsinput/issues"
  },
  "homepage": "https://github.com/olahol/react-tagsinput",
  "files": [
    "react-tagsinput.css"
  ],
  "nyc": {
    "include": [
      "src/index.js"
    ]
  }
}
